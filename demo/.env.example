# AEOS M01 Kernel DEMO environment template
# Copy to .env and replace ALL secrets before use. Never commit real .env files.
M01_MODE=demo
PORT=3101
HOST=0.0.0.0
M01_POSTGRES_DB=m01
M01_POSTGRES_USER=m01
M01_POSTGRES_PASSWORD=change-me-before-use
M01_DATABASE_URL=postgres://m01:change-me-before-use@postgres:5432/m01
M01_ADMIN_TOKEN=local-demo-admin
M01_DEMO_ONE_CLICK_LOGIN=true
M07_WEBHOOK_SECRET=local-demo-m07-secret
M13_WEBHOOK_SECRET=local-demo-m13-secret
M01_PRIMARY_OWNER_ENABLED=true
M01_PRIMARY_TENANT_ID=TENANT_A
M01_PRIMARY_TENANT_NAME=恒剑光电
M01_PRIMARY_OWNER_PERSON_ID=P_OWNER
M01_PRIMARY_OWNER_NAME=朱剑军

# Formal profile (replace placeholders; never commit real secrets).
# M01_MODE=oidc
# M01_OIDC_ISSUER=http://keycloak:8080/realms/aeos
# M01_OIDC_AUDIENCE=aeos-m01
# M01_OIDC_JWKS_URI=http://keycloak:8080/realms/aeos/protocol/openid-connect/certs
# M01_OIDC_CLIENT_ID=aeos-m01-console
# M01_OIDC_REDIRECT_URI=http://localhost:3101/
# M01_OIDC_SCOPES=openid profile email m01:policy:read
# M01_EXTERNAL_IDENTITIES_JSON=[{"issuer":"http://keycloak:8080/realms/aeos","subject":"<keycloak-sub>","principal_id":"P_OWNER","tenant_id":"TENANT_A"}]

# Optional local migration bootstrap. When set, M01 imports EBMS personnel before listening.
# Passwords are never read into M01; users are only used for safe account matching.
M01_EBMS_SOURCE_DIR=
M01_EBMS_TENANT_ID=TENANT_A
M01_EBMS_IMPORT_STATUS=all
M01_EBMS_IMPORT_ACCOUNT=all
M01_EBMS_IMPORT_DEPARTMENT=
M01_EBMS_SYNC_URL=http://host.docker.internal:3010
M01_EBMS_SYNC_TOKEN=请设置为与EBMS相同的机机同步密钥

# Formal mode requires Keycloak realm, client, external identity mapping and an active Owner.
