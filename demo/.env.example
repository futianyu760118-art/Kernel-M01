# AEOS M01 Kernel DEMO environment template
# Copy to .env and replace ALL secrets before use. Never commit real .env files.
M01_MODE=demo
PORT=3101
HOST=0.0.0.0
M01_ADMIN_TOKEN=local-demo-admin
M07_WEBHOOK_SECRET=local-demo-m07-secret
M13_WEBHOOK_SECRET=local-demo-m13-secret

# Switch to OIDC only after the Keycloak realm and M01 Owner configuration are signed off.
# M01_MODE=oidc
# M01_OIDC_ISSUER=http://127.0.0.1:8080/realms/aeos-dev
# M01_OIDC_AUDIENCE=aeos-portal
# M01_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/aeos-dev/protocol/openid-connect/certs
# M01_OIDC_REQUIRED_SCOPE=portal:read
